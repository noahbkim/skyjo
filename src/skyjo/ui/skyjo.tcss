Screen { background: $surface; }
#setup-body { padding: 1 2; }
Label { height: auto; margin-top: 1; }
.toolbar { height: 3; }
.toolbar Button { min-width: 8; width: auto; margin-right: 1; }
.toolbar Input { width: 1fr; }
.toolbar Select { width: 16; }
.input-pair { height: 3; }
.input-pair Input { width: 1fr; }
#seat-editors, SeatEditor, .model-options, .search-options { height: auto; }
#setup-status { height: auto; min-height: 1; color: $warning; }
#game-status { height: auto; min-height: 1; padding: 0 1; }
#card-context { height: 4; }
#current-card { width: 3fr; height: 4; border: round $accent; }
#deck-summary { width: 2fr; height: 4; border: round $primary-muted; }
#table-content { height: 1fr; }
#boards-pane { width: 3fr; }
#diagnostics-pane { width: 2fr; border-left: solid $primary-muted; padding: 0 1; overflow-x: auto; }
#diagnostics { width: auto; min-width: 100%; }
#boards { grid-size: 2; grid-rows: 10; height: auto; }
.board { height: 10; padding: 0 1; }
.panel-title { text-style: bold; color: $accent; }
#human-controls { height: auto; padding: 0 1; }
#human-prompt { margin-top: 0; }
#card-actions { grid-size: 4; grid-rows: 3; height: 9; }
#card-actions Button { width: 1fr; min-width: 5; }
#table-message { height: auto; max-height: 3; color: $warning; padding: 0 1; }
TableScreen.narrow #table-content { layout: vertical; }
TableScreen.narrow #boards-pane { width: 1fr; height: 2fr; }
TableScreen.narrow #diagnostics-pane { width: 1fr; height: 1fr; border-left: none; border-top: solid $primary-muted; }
